{
  "$defs": {
    "SourceSpan": {
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "parent_section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Section"
        },
        "start_offset": {
          "minimum": 0,
          "title": "Start Offset",
          "type": "integer"
        },
        "end_offset": {
          "exclusiveMinimum": 0,
          "title": "End Offset",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "label",
        "start_offset",
        "end_offset",
        "text"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "doc_id": {
      "minLength": 1,
      "title": "Doc Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "content": {
      "minLength": 1,
      "title": "Content",
      "type": "string"
    },
    "owner": {
      "minLength": 1,
      "title": "Owner",
      "type": "string"
    },
    "source_version": {
      "minLength": 12,
      "title": "Source Version",
      "type": "string"
    },
    "related_docs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Related Docs",
      "type": "array"
    },
    "sections": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceSpan"
      },
      "title": "Sections",
      "type": "array"
    },
    "steps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceSpan"
      },
      "title": "Steps",
      "type": "array"
    },
    "permissions": {
      "default": [
        "customer_support"
      ],
      "items": {
        "type": "string"
      },
      "title": "Permissions",
      "type": "array"
    }
  },
  "required": [
    "doc_id",
    "title",
    "content",
    "owner",
    "source_version"
  ],
  "title": "CanonicalDocument",
  "type": "object"
}
