      },
      "title": "Passages",
      "type": "array"
    },
    "searches": {
      "maximum": 2,
      "minimum": 0,
      "title": "Searches",
      "type": "integer"
    },
    "sufficient": {
      "title": "Sufficient",
      "type": "boolean"
    },
    "reason": {
      "default": "",
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "ticket_id",
    "snapshot_revision",
    "passages",
    "searches",
    "sufficient"
