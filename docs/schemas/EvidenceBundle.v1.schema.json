        "doc_id": {
          "title": "Doc Id",
          "type": "string"
        },
        "passage_id": {
          "title": "Passage Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "source_version": {
          "title": "Source Version",
          "type": "string"
        },
        "start_offset": {
          "default": 0,
          "title": "Start Offset",
          "type": "integer"
        },
        "end_offset": {
          "default": 0,
          "title": "End Offset",
          "type": "integer"
        }
