# Copy to a private .env only when using Azure; extractive mode needs no secrets.
AZURE_GPT_4o_ENDPOINT=
AZURE_DEPLOYMENT_GPT_4o=gpt-4o
AZURE_GPT_4o_API_VERSION=2024-12-01-preview
AZURE_GPT_4o_API_KEY=
AZURE_O3_mini_ENDPOINT=
AZURE_O3_mini_DEPLOYMENT_NAME=o3-mini
AZURE_O3_mini_VERSION=2024-12-01-preview
AZURE_O3_mini_API_KEY=
embedding_endpoint_url=
embedding_model_name=text-embedding-ada-002
embedding_api_version=2023-05-15
embedding_api_key=
CLOUDSERVE_MODEL_MODE=extractive
# Optional deployment-specific prices. Usage is counted from provider responses;
# leave these at zero and the Trust Center reports price_not_configured.
CLOUDSERVE_GPT4O_INPUT_USD_PER_M=0
CLOUDSERVE_GPT4O_OUTPUT_USD_PER_M=0
CLOUDSERVE_O3MINI_INPUT_USD_PER_M=0
CLOUDSERVE_O3MINI_OUTPUT_USD_PER_M=0
CLOUDSERVE_ADA002_INPUT_USD_PER_M=0
CLOUDSERVE_RUNTIME_DIR=
CLOUDSERVE_API_PORT=8001
# Security (leave CLOUDSERVE_API_KEYS empty to use the documented local demo keys)
CLOUDSERVE_API_KEYS=
CLOUDSERVE_DEMO_KEYS=1
CLOUDSERVE_DATA_KEY=
CLOUDSERVE_RATE_LIMIT_PER_MIN=600
# Retrieval and operations
CLOUDSERVE_RETRIEVAL_STRATEGY=
CLOUDSERVE_INDEX_DIR=
CLOUDSERVE_AUTO_SEND_DISABLED=
